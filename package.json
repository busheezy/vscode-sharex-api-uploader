{
  "name": "sharex-api-uploader",
  "displayName": "ShareX API Uploader",
  "version": "0.1.0",
  "description": "Upload text files to ShareX API.",
  "categories": [
    "Other"
  ],
  "license": "dwyw",
  "repository": "https://github.com/busheezy/vscode-sharex-api-uploader",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm compile && pnpm lint",
    "lint": "oxlint --deny-warnings",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "build": "pnpm compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "~7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "sharex-api-uploader.share",
        "title": "Share: Upload"
      },
      {
        "command": "sharex-api-uploader.setSecret",
        "title": "Share: Set Secret"
      }
    ],
    "configuration": {
      "title": "Share",
      "properties": {
        "share.apiUrl": {
          "type": "string",
          "required": true,
          "description": "URL of share API."
        },
        "share.responseUrl": {
          "type": "string",
          "required": true,
          "description": "URL of response to prepend to string id."
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:sharex-api-uploader.setSecret",
    "onCommand:sharex-api-uploader.share"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "vscode": "^1.136.0"
  },
  "packageManager": "pnpm@12.3.4"
}
